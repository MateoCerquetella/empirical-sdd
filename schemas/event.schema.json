{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MateoCerquetella/empirical-sdd/raw/main/schemas/event.schema.json",
  "title": "Empirical SDD transition event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "occurredAt", "expectedRevision", "revision", "kind", "actor", "summary", "previousEvent", "state"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "revision": { "type": "integer", "minimum": 1 },
    "kind": {
      "enum": ["adopted", "spec_selected", "spec_changed", "phase_started", "phase_passed", "phase_failed", "repair_scheduled", "human_requested", "human_approved", "blocked", "evidence_recorded", "delivery_completed", "completed", "recovered"]
    },
    "actor": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "previousEvent": { "type": ["string", "null"] },
    "state": { "$ref": "state.schema.json" }
  }
}
