{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MateoCerquetella/empirical-sdd/raw/main/schemas/phase-result.schema.json",
  "title": "Empirical SDD phase result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcome", "actor", "summary", "evidence", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "outcome": { "enum": ["passed", "failed", "awaiting_human"] },
    "actor": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "$ref": "evidence.schema.json" } },
    "artifacts": {
      "type": "array",
      "description": "Repository-relative paths to non-empty regular files produced or validated by the phase.",
      "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
      "uniqueItems": true
    }
  }
}
